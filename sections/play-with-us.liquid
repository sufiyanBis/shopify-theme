{{ 'play-with-us.css' | asset_url | stylesheet_tag }}


<div class="play-with-us">

  <div class="play-with-us__container">

    <div class="play-with-us__header">
      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="play-with-us__wheel-area">

      <div class="play-with-us__pointer" aria-hidden="true">
        ▼
      </div>

      <div class="play-with-us__wheel-wrapper">

        <div
          class="play-with-us__wheel"
          data-wheel
        >
          <div class="play-with-us__segment segment-1">
            10% OFF
          </div>

          <div class="play-with-us__segment segment-2">
            15% OFF
          </div>

          <div class="play-with-us__segment segment-3">
            FREE SHIPPING
          </div>

          <div class="play-with-us__segment segment-4">
            20% OFF
          </div>

          <div class="play-with-us__segment segment-5">
            5% OFF
          </div>

          <div class="play-with-us__segment segment-6">
            TRY AGAIN
          </div>
        </div>

        <div class="play-with-us__wheel-center">
          SPIN
        </div>

      </div>

    </div>

    <div class="play-with-us__controls">

      <button
        type="button"
        class="play-with-us__spin-button"
        data-spin
      >
        Spin the Wheel
      </button>

    </div>

    <div
      class="play-with-us__result"
      data-result
      aria-live="polite"
    >
      Spin the wheel to reveal your prize!
    </div>

    <button
      type="button"
      class="play-with-us__reset-button"
      data-reset
    >
      Spin Again
    </button>

  </div>

</div>

<script src="{{ 'play-with-us.js' | asset_url }}" defer></script>


{% schema %}
{
  "name": "sufiyan and naveed",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "sufiyan and naveed"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Spin the wheel and see what surprise you get!"
    }
  ],

  "presets": [
    {
      "name": "sufiyan and naveed"
    }
  ]
}
{% endschema %}
