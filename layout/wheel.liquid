<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fff9f0">
    <title>{{ page.title | default: shop.name | escape }}</title>
    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
    -%}
    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { font-size: 62.5%; background: #fff9f0; }
      body {
        min-height: 100%;
        margin: 0;
        background: #fff9f0;
        font-family: var(--font-body-family);
        font-size: 1.6rem;
      }
      h1, h2, h3 { font-family: var(--font-heading-family); }
      .wheel-embed .play-with-us { min-height: 100dvh; padding-top: 3rem; }
    {% endstyle %}
  </head>
  <body class="wheel-embed">
    <main id="MainContent">{{ content_for_layout }}</main>
    <script>document.documentElement.classList.remove('no-js');</script>
    <script src="{{ 'play-with-us-embed.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
