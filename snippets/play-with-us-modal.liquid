{%- assign play_page_url = pages['play-with-us'].url | default: '/pages/play-with-us' -%}
{%- assign play_embed_url = play_page_url | append: '?view=play-with-us-embed' -%}

{{ 'play-with-us-modal.css' | asset_url | stylesheet_tag }}

<div
  id="PlayWithUsModal"
  class="play-modal"
  data-play-with-us-modal
  data-wheel-url="{{ play_embed_url }}"
  hidden
>
  <div class="play-modal__backdrop" data-play-modal-close></div>
  <section
    class="play-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="PlayWithUsModalTitle"
    tabindex="-1"
  >
    <header class="play-modal__header">
      <div>
        <span class="play-modal__eyebrow">Bis Research</span>
        <h2 id="PlayWithUsModalTitle">{{ settings.cart_game_modal_heading | escape }}</h2>
      </div>
      <button
        type="button"
        class="play-modal__close"
        data-play-modal-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="play-modal__stage" data-play-modal-stage>
      <div class="play-modal__status" data-play-modal-status role="status" aria-live="polite">
        <span class="play-modal__loader" aria-hidden="true"></span>
        <span data-play-modal-status-text>{{ settings.cart_game_modal_loading | escape }}</span>
        <a href="{{ play_embed_url }}" data-play-modal-fallback>
          {{ settings.cart_game_modal_fallback_label | escape }}
        </a>
      </div>
      <iframe
        class="play-modal__frame"
        data-play-modal-frame
        data-src="{{ play_embed_url }}"
        title="{{ settings.cart_game_modal_heading | escape }}"
        scrolling="no"
        sandbox="allow-scripts allow-same-origin allow-top-navigation-by-user-activation"
      ></iframe>
    </div>
  </section>
</div>

<script>
  window.playWithUsModalStrings = {
    loading: {{ settings.cart_game_modal_loading | json }},
    error: {{ settings.cart_game_modal_error | json }}
  };
</script>
<script src="{{ 'play-with-us-modal.js' | asset_url }}" defer="defer"></script>
