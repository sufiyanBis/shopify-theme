{{ 'bis-service-pages.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .bis-service-page {
    --bis-service-ink: {{ section.settings.color_ink }};
    --bis-service-porcelain: {{ section.settings.color_background }};
    --bis-service-pink: {{ section.settings.color_pink }};
    --bis-service-mint: {{ section.settings.color_mint }};
    --bis-service-acid: {{ section.settings.color_acid }};
    --bis-service-green: {{ section.settings.color_green }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .bis-service-page {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign contact_url = section.settings.contact_link
  if contact_url == blank and pages.contact != blank
    assign contact_url = pages.contact.url
  endif
  if contact_url == blank
    assign contact_url = routes.root_url
  endif
-%}

<section class="bis-service-page bis-shipping-returns" aria-labelledby="ShippingReturnsTitle-{{ section.id }}">
  <div class="bis-service-page__shell">
    <header class="bis-service-page__hero">
      <div class="bis-service-page__hero-copy">
        {%- if section.settings.kicker != blank -%}<p class="bis-service-page__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h1 class="bis-service-page__title" id="ShippingReturnsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.intro != blank -%}<div class="bis-service-page__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
      </div>
      {%- if section.settings.hero_note_heading != blank or section.settings.hero_note != blank -%}
        <aside class="bis-service-page__hero-aside" aria-label="{{ section.settings.hero_note_heading | default: section.settings.kicker | escape }}">
          {%- if section.settings.hero_note_heading != blank -%}<strong>{{ section.settings.hero_note_heading | escape }}</strong>{%- endif -%}
          {%- if section.settings.hero_note != blank -%}<p>{{ section.settings.hero_note | escape }}</p>{%- endif -%}
        </aside>
      {%- endif -%}
    </header>

    {%- assign policy_blocks = section.blocks | where: 'type', 'policy' -%}
    {%- if policy_blocks.size > 0 -%}
      <div class="bis-service-page__section">
        <div class="bis-service-page__section-head">
          <h2 class="bis-service-page__section-title">{{ section.settings.policy_heading | escape }}</h2>
          {%- if section.settings.policy_text != blank -%}<div class="bis-service-page__section-copy rte">{{ section.settings.policy_text }}</div>{%- endif -%}
        </div>
        <div class="bis-service-page__policy-grid">
          {%- for block in policy_blocks -%}
            <article class="bis-service-page__policy-card bis-service-page__policy-card--{{ block.settings.accent }}" {{ block.shopify_attributes }}>
              {%- if block.settings.kicker != blank -%}<p class="bis-service-page__eyebrow">{{ block.settings.kicker | escape }}</p>{%- endif -%}
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
    {%- if step_blocks.size > 0 -%}
      <div class="bis-service-page__section">
        <div class="bis-service-page__section-head">
          <h2 class="bis-service-page__section-title">{{ section.settings.steps_heading | escape }}</h2>
          {%- if section.settings.steps_text != blank -%}<div class="bis-service-page__section-copy rte">{{ section.settings.steps_text }}</div>{%- endif -%}
        </div>
        <ol class="bis-service-page__timeline">
          {%- for block in step_blocks -%}
            <li class="bis-service-page__step" {{ block.shopify_attributes }}>
              <span class="bis-service-page__step-number" aria-hidden="true">{{ block.settings.number | escape }}</span>
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- assign detail_blocks = section.blocks | where: 'type', 'detail' -%}
    {%- if detail_blocks.size > 0 -%}
      <div class="bis-service-page__section">
        <div class="bis-service-page__section-head">
          <h2 class="bis-service-page__section-title">{{ section.settings.details_heading | escape }}</h2>
          {%- if section.settings.details_text != blank -%}<div class="bis-service-page__section-copy rte">{{ section.settings.details_text }}</div>{%- endif -%}
        </div>
        <div class="bis-service-page__details-list">
          {%- for block in detail_blocks -%}
            <details class="bis-service-page__details" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="bis-service-page__details-answer rte">{{ block.settings.text }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="bis-service-page__section">
      <div class="bis-service-page__contact-panel">
        <div>
          <h2>{{ section.settings.contact_heading | escape }}</h2>
          <div class="rte">{{ section.settings.contact_text }}</div>
        </div>
        <a class="bis-service-page__button bis-service-page__button--light" href="{{ contact_url }}">{{ section.settings.contact_label | escape }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIS — Shipping & returns",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The practical details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>A clear guide to dispatch, delivery, returns, exchanges and refunds. Replace these general notes with the policies that apply to your store.</p>" },
    { "type": "text", "id": "hero_note_heading", "label": "Hero note heading", "default": "Before you order" },
    { "type": "textarea", "id": "hero_note", "label": "Hero note", "default": "Delivery timing and return eligibility can vary by item and destination." },
    { "type": "header", "content": "Policy cards" },
    { "type": "text", "id": "policy_heading", "label": "Heading", "default": "The short version" },
    { "type": "richtext", "id": "policy_text", "label": "Introduction", "default": "<p>Use these cards for the information customers need most often. Keep dates, fees and eligibility aligned with your published store policies.</p>" },
    { "type": "header", "content": "Returns timeline" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "A smoother return" },
    { "type": "richtext", "id": "steps_text", "label": "Introduction", "default": "<p>Explain your store's process in a few simple checkpoints so customers know what to prepare and what happens next.</p>" },
    { "type": "header", "content": "Additional details" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "Worth knowing" },
    { "type": "richtext", "id": "details_text", "label": "Introduction", "default": "<p>Add any exceptions, regional information or item-specific guidance below.</p>" },
    { "type": "header", "content": "Contact call to action" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Not sure what applies?" },
    { "type": "richtext", "id": "contact_text", "label": "Text", "default": "<p>Contact our team before sending an item back and we will point you in the right direction.</p>" },
    { "type": "text", "id": "contact_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_ink", "label": "Ink", "default": "#15171C" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#F4F1EB" },
    { "type": "color", "id": "color_pink", "label": "Hot pink", "default": "#EF2F76" },
    { "type": "color", "id": "color_mint", "label": "Mint", "default": "#45C0B6" },
    { "type": "color", "id": "color_acid", "label": "Acid", "default": "#E9F957" },
    { "type": "color", "id": "color_green", "label": "Deep green", "default": "#123F32" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Policy card",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Good to know" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your dispatch estimate, delivery range and any shipping charges here.</p>" },
        { "type": "select", "id": "accent", "label": "Accent", "default": "mint", "options": [
          { "value": "mint", "label": "Mint" },
          { "value": "pink", "label": "Pink" },
          { "value": "acid", "label": "Acid" },
          { "value": "green", "label": "Deep green" }
        ] },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "step",
      "name": "Return step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Check eligibility" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Review the return window, item condition and any exclusions that apply.</p>" }
      ]
    },
    {
      "type": "detail",
      "name": "Expandable detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "When will my refund arrive?" },
        { "type": "richtext", "id": "text", "label": "Answer", "default": "<p>Add your inspection and refund processing timeline here. Banking providers may need additional time to post the credit.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIS — Shipping & returns",
      "blocks": [
        { "type": "policy" },
        { "type": "policy" },
        { "type": "policy" },
        { "type": "policy" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "detail" },
        { "type": "detail" }
      ]
    }
  ]
}
{% endschema %}
