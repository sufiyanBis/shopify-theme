<footer class="custom-footer">

  <div class="custom-footer__container">

    <!-- BRAND-name -->
    <div class="custom-footer__brand">

      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            loading: 'lazy',
            alt: section.settings.brand_name
        }}
      {% else %}
        <h2>{{ section.settings.brand_name }}</h2>
      {% endif %}

      <p>{{ section.settings.description }}</p>

    </div>


    <!-- FOOTER MENUS -->
    <div class="custom-footer__menus">

      {% for block in section.blocks %}

        <div class="custom-footer__menu" {{ block.shopify_attributes }}>

          {% if block.settings.heading != blank %}
            <h3>{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.menu != blank %}

            <ul>
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>

          {% endif %}

        </div>

      {% endfor %}


      <!-- SOCIAL MEDIA -->
      <div class="custom-footer__social">

        <h3>{{ section.settings.social_heading }}</h3>

        <div class="custom-footer__social-icons">

          {% if section.settings.facebook_url != blank %}
            <a
              href="{{ section.settings.facebook_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v2H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1z"/>
              </svg>
            </a>
          {% endif %}


          {% if section.settings.instagram_url != blank %}
            <a
              href="{{ section.settings.instagram_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1"/>
              </svg>
            </a>
          {% endif %}


          {% if section.settings.x_url != blank %}
            <a
              href="{{ section.settings.x_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 3h5.2l3.5 5.1L16.8 3H20l-5.8 6.7L21 21h-5.2l-4-5.8L6.8 21H3.6l6.3-7.4L4 3zm4.5 2 8.2 11.9h1.3L9.8 5H8.5z"/>
              </svg>
            </a>
          {% endif %}

        </div>

      </div>

    </div>

  </div>

</footer>




{% schema %}

{
  "name": "Custom Footer",

  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Makhana Walas"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium quality snacks crafted for modern Indian homes."
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Social"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X URL"
    }
  ],

  "blocks": [
    {
      "type": "menu",
      "name": "Footer menu",

      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select menu"
        }
      ]
    }
  ],

  "max_blocks": 4,

  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "CONTACT"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "HELP"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "CATEGORY"
          }
        }
      ]
    }
  ]
}

{% endschema %}