{{ 'catalog-showroom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'catalog-showroom.js' | asset_url }}" defer="defer"></script>

<section class="custom-products catalog-showroom catalog-showroom--custom" data-catalog-showroom>

  <header class="catalog-showroom__intro">
    <div>
      <p class="catalog-showroom__eyebrow">{{ 'sections.collection_template.title' | t }}</p>
      <h2 class="catalog-showroom__title">
        {{ section.settings.heading | default: section.settings.collection.title | escape }}
      </h2>
    </div>

    {% if section.settings.collection != blank %}
      <p class="catalog-showroom__count">
        <span>
          {{- 'products.facets.product_count_simple' | t: count: section.settings.collection.products_count -}}
        </span>
      </p>
    {% endif %}
  </header>

  {% if section.settings.collection != blank %}

    <div class="custom-products__grid">

      {% for product in section.settings.collection.products %}

        {% render 'product-card',
          product_item: product
        %}

      {% endfor %}

    </div>

  {% else %}

    <p class="custom-products__empty">
      Please select a collection.
    </p>

  {% endif %}

</section>


{% schema %}
{
  "name": "Custom Products",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The product archive"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    }
  ],

  "presets": [
    {
      "name": "Custom Products"
    }
  ]
}
{% endschema %}
